<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="NevFontFamily">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Font Sizes -->
    <x:Double x:Key="NevFontSizeTitle">28</x:Double>
    <x:Double x:Key="NevFontSizeHeader">20</x:Double>
    <x:Double x:Key="NevFontSizeBody">14</x:Double>
    <x:Double x:Key="NevFontSizeCaption">12</x:Double>

    <!-- Text Styles -->
    <Style x:Key="NevTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NevFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource NevFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NevTextPrimaryBrush}" />
    </Style>

    <Style x:Key="NevHeaderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NevFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource NevFontSizeHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NevTextPrimaryBrush}" />
    </Style>

    <Style x:Key="NevBodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NevFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource NevFontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource NevTextPrimaryBrush}" />
    </Style>

    <Style x:Key="NevCaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NevFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource NevFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource NevTextSecondaryBrush}" />
    </Style>

</ResourceDictionary>
