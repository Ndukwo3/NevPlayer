<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Palette -->
    <Color x:Key="NevBackgroundColor">#0A0A0A</Color>
    <Color x:Key="NevSurfaceColor">#141414</Color>
    <Color x:Key="NevSurfaceElevatedColor">#1E1E1E</Color>
    
    <!-- Accents -->
    <Color x:Key="NevAccentColor">#7A32F0</Color>
    <Color x:Key="NevAccentHoverColor">#8E4DF5</Color>
    <Color x:Key="NevAccentPressedColor">#6423D1</Color>
    
    <!-- Text -->
    <Color x:Key="NevTextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="NevTextSecondaryColor">#A0A0A0</Color>
    
    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="NevBackgroundBrush" Color="{StaticResource NevBackgroundColor}" />
    <SolidColorBrush x:Key="NevSurfaceBrush" Color="{StaticResource NevSurfaceColor}" />
    <SolidColorBrush x:Key="NevSurfaceElevatedBrush" Color="{StaticResource NevSurfaceElevatedColor}" />
    <SolidColorBrush x:Key="NevAccentBrush" Color="{StaticResource NevAccentColor}" />
    <SolidColorBrush x:Key="NevTextPrimaryBrush" Color="{StaticResource NevTextPrimaryColor}" />
    <SolidColorBrush x:Key="NevTextSecondaryBrush" Color="{StaticResource NevTextSecondaryColor}" />

</ResourceDictionary>
