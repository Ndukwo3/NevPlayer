<Page
    x:Class="NevPlayer.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NevPlayer.Core.Models"
    mc:Ignorable="d"
    Background="{StaticResource NevBackgroundBrush}">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Recently Played" Style="{StaticResource NevTitleTextBlockStyle}" FontSize="42" FontWeight="Bold" />
                <TextBlock Text="Your playback history" Style="{StaticResource NevHeaderTextBlockStyle}" Foreground="#999999" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Clear History" Click="ClearHistory_Click"
                    Style="{StaticResource NevSecondaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
        </Grid>

        <!-- History List -->
        <ListView x:Name="HistoryListView" Grid.Row="1"
                  ItemsSource="{x:Bind HistoryItems, Mode=OneWay}"
                  IsItemClickEnabled="True" ItemClick="HistoryListView_ItemClick"
                  SelectionMode="None" Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryItem">
                    <Border Background="{StaticResource NevSurfaceBrush}" CornerRadius="{StaticResource NevControlCornerRadius}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail -->
                            <Border Grid.Column="0" Width="80" Height="45" CornerRadius="6" Background="#1E1E1E" Margin="0,0,16,0">
                                <Image Source="{Binding ArtworkPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                            </Border>

                            <!-- Metadata -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind LastPlayed}" Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#999999" Margin="0,4,0,0" />
                                <!-- Progress Bar -->
                                <ProgressBar Value="{x:Bind LastPosition.TotalSeconds}" Maximum="{x:Bind Duration.TotalSeconds}"
                                             Foreground="{StaticResource NevAccentBrush}" Background="#333333"
                                             Margin="0,8,0,0" Height="3" CornerRadius="2" />
                            </StackPanel>

                            <!-- Duration -->
                            <TextBlock Grid.Column="2" Text="{x:Bind Duration}" Style="{StaticResource NevCaptionTextBlockStyle}"
                                       Foreground="#666666" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="16" Visibility="Collapsed">
            <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="64" Foreground="#333333" />
            <TextBlock Text="No history yet" Style="{StaticResource NevHeaderTextBlockStyle}" Foreground="#555555" HorizontalAlignment="Center" />
            <TextBlock Text="Start playing some media to see it here." Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#444444" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
