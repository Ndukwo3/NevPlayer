<Page
    x:Class="NevPlayer.App.Views.CinemaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    xmlns:converters="using:NevPlayer.App.Converters"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{StaticResource NevBackgroundBrush}"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="Spacebar_Invoked" />
        <KeyboardAccelerator Key="Right" Invoked="RightArrow_Invoked" />
        <KeyboardAccelerator Key="Left" Invoked="LeftArrow_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <converters:BoolToBrushConverter x:Key="ActiveItemBrushConverter" TrueBrush="#B13BFF" FalseBrush="White" />
        <Storyboard x:Name="OsdFadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="OsdOverlay" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.1" />
        </Storyboard>
        <Storyboard x:Name="OsdFadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="OsdOverlay" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.3" />
        </Storyboard>
        <Storyboard x:Name="SlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="PlaylistTranslateTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="PlaylistTranslateTransform" Storyboard.TargetProperty="X" To="360" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="BottomSlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="BottomTranslateTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BottomControlDock" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
        </Storyboard>
        <Storyboard x:Name="BottomSlideOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="BottomTranslateTransform" Storyboard.TargetProperty="Y" To="150" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BottomControlDock" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
        </Storyboard>
    </Page.Resources>

    <Grid PointerWheelChanged="Grid_PointerWheelChanged" DoubleTapped="VideoSurface_DoubleTapped">
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="PlayerContextMenu">
                <!-- Populated dynamically in code-behind to match PotPlayer context menu -->
            </MenuFlyout>
        </Grid.ContextFlyout>


        <!-- Native Windows MediaPlayer Element -->
        <MediaPlayerElement Grid.Column="0" x:Name="VideoSurface" AreTransportControlsEnabled="False" Stretch="Uniform" />

        <!-- LibVLCSharp VideoView -->
        <vlc:VideoView Grid.Column="0" x:Name="VlcVideoSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" />

        <!-- Audio Music Visualizer Bar Display (Visible only during music playback) -->
        <Grid Grid.Column="0" x:Name="AudioVisualizerGrid" Background="#0C0C0C" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="40">
                <!-- Glowing Album Disk Card -->
                <Border Width="240" Height="240" CornerRadius="120" Background="#111111" BorderBrush="#22FFFFFF" BorderThickness="4" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform x:Name="DiscRotation" Angle="0" />
                    </Border.RenderTransform>
                    <Grid>
                        <Ellipse Width="240" Height="240">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="VisualizerAlbumArt" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Center Spindle Glow -->
                        <Ellipse Width="48" Height="48" Fill="#FF181818" Stroke="{StaticResource NevAccentBrush}" StrokeThickness="2" />
                    </Grid>
                </Border>

                <!-- Music Bar Waveform Animation Display -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Height="160">
                    <Border x:Name="VisualizerBar1" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="25" />
                    <Border x:Name="VisualizerBar2" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="50" />
                    <Border x:Name="VisualizerBar3" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="20" />
                    <Border x:Name="VisualizerBar4" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="90" />
                    <Border x:Name="VisualizerBar5" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="40" />
                    <Border x:Name="VisualizerBar6" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="110" />
                    <Border x:Name="VisualizerBar7" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="65" />
                    <Border x:Name="VisualizerBar8" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="130" />
                    <Border x:Name="VisualizerBar9" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="60" />
                    <Border x:Name="VisualizerBar10" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="80" />
                    <Border x:Name="VisualizerBar11" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="20" />
                    <Border x:Name="VisualizerBar12" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="100" />
                    <Border x:Name="VisualizerBar13" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="30" />
                    <Border x:Name="VisualizerBar14" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="70" />
                    <Border x:Name="VisualizerBar15" Width="12" CornerRadius="6" Background="{StaticResource NevAccentBrush}" VerticalAlignment="Bottom" Height="45" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Custom Subtitle Overlay TextBlock -->
        <Grid Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,140" IsHitTestVisible="False">
            <Border x:Name="SubtitleBackgroundBorder" Background="#B3000000" CornerRadius="4" Padding="12,6" Visibility="Collapsed">
                <TextBlock x:Name="SubtitleTextBlock" Text="" FontSize="24" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- On-Screen Display (OSD) Overlay -->
        <Grid x:Name="OsdOverlay" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#99000000" CornerRadius="12" Padding="24,12" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="OsdText" Text="Volume: 100%" Style="{StaticResource NevTitleTextBlockStyle}" FontSize="36" FontWeight="Bold" Foreground="White" />
        </Grid>

        <!-- Bottom Controls Overlay (Visible over the video) -->
        <Grid x:Name="BottomControlDock" Grid.Column="0" VerticalAlignment="Bottom" Padding="40" Background="#99000000" Opacity="0" PointerEntered="BottomControlDock_PointerEntered" PointerExited="BottomControlDock_PointerExited" PointerCanceled="BottomControlDock_PointerExited" PointerCaptureLost="BottomControlDock_PointerExited">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BottomTranslateTransform" Y="150" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Timeline & Time -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00:00" Style="{StaticResource NevCaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <!-- Custom styling would be applied to the Slider to make it purple -->
                <Slider x:Name="TimelineSlider" Grid.Column="1" Value="0" Maximum="100" VerticalAlignment="Center" ValueChanged="TimelineSlider_ValueChanged" />
                <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00:00" Style="{StaticResource NevCaptionTextBlockStyle}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
            
            <!-- Controls Bar -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Metadata block -->
                    <ColumnDefinition Width="*" />
                    <!-- Playback Controls -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Utility Controls -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Metadata -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="MediaTitleText" Text="Loading..." Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock x:Name="MediaMetadataText" Text="" Style="{StaticResource NevCaptionTextBlockStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Center: Playback -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="18" Click="Previous_Click" ToolTipService.ToolTip="Previous" />
                    <Button Content="&#xEB9E;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="20" Click="SkipBackward_Click" ToolTipService.ToolTip="Skip Backward 10s" />
                    <Button x:Name="PlayPauseButton" Content="&#xE103;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource NevPrimaryButtonStyle}" CornerRadius="24" Width="48" Height="48" Click="PlayPause_Click" />
                    <Button Content="&#xEB9D;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="20" Click="SkipForward_Click" ToolTipService.ToolTip="Skip Forward 10s" />
                    <Button Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="18" Click="Next_Click" ToolTipService.ToolTip="Next" />
                </StackPanel>

                <!-- Right: Utilities -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#xE194;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="White">
                        <Button.Flyout>
                            <MenuFlyout x:Name="SubtitleMenuFlyout">
                                <!-- Populated dynamically in code-behind -->
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="&#xE158;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="White">
                        <Button.Flyout>
                            <MenuFlyout x:Name="AudioMenuFlyout">
                                <!-- Populated dynamically in code-behind -->
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Slider x:Name="VolumeSlider" Width="100" Value="100" Maximum="200" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                    <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="White">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="12" Width="240">
                                    <TextBlock Text="Playback Settings" Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold"/>
                                    
                                    <TextBlock Text="Playback Speed" Style="{StaticResource NevCaptionTextBlockStyle}" Margin="0,8,0,0"/>
                                    <ComboBox x:Name="SpeedComboBox" HorizontalAlignment="Stretch" SelectedIndex="2" SelectionChanged="SpeedComboBox_SelectionChanged">
                                        <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                        <ComboBoxItem Content="0.75x" Tag="0.75"/>
                                        <ComboBoxItem Content="1.0x" Tag="1.0"/>
                                        <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                        <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                        <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                    </ComboBox>

                                    <TextBlock Text="Aspect Ratio" Style="{StaticResource NevCaptionTextBlockStyle}" Margin="0,8,0,0"/>
                                    <ComboBox x:Name="AspectRatioComboBox" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="AspectRatioComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Fit (Uniform)" Tag="Uniform"/>
                                        <ComboBoxItem Content="Fill (UniformToFill)" Tag="UniformToFill"/>
                                        <ComboBoxItem Content="Stretch" Tag="Stretch"/>
                                    </ComboBox>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Edge Trigger for Auto-Hide Bottom Controls -->
        <Border x:Name="BottomEdgeTrigger" Grid.Column="0" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="Transparent" PointerEntered="BottomEdgeTrigger_PointerEntered" />

        <!-- Edge Trigger for Auto-Hide Playlist -->
        <Border x:Name="PlaylistEdgeTrigger" Grid.Column="0" Width="20" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" PointerEntered="PlaylistEdgeTrigger_PointerEntered" />

        <!-- Right Side: Playlist Drawer -->
        <Border x:Name="PlaylistDrawer" Grid.Column="0" Width="360" HorizontalAlignment="Right" Background="{StaticResource NevSurfaceBrush}" Visibility="Visible" PointerEntered="PlaylistDrawer_PointerEntered" PointerExited="PlaylistDrawer_PointerExited" PointerCanceled="PlaylistDrawer_PointerExited" PointerCaptureLost="PlaylistDrawer_PointerExited">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PlaylistTranslateTransform" X="360" />
            </Border.RenderTransform>
            <Grid Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PLAYLIST" Style="{StaticResource NevHeaderTextBlockStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="&#xE109;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Add File" Click="AddPlaylist_Click" Background="Transparent" BorderThickness="0" Foreground="White" />
                        <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Clear" Click="ClearPlaylist_Click" Background="Transparent" BorderThickness="0" Foreground="White" />
                        <Button Content="&#xE105;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Save Playlist" Click="SavePlaylist_Click" Background="Transparent" BorderThickness="0" Foreground="White" />
                    </StackPanel>
                </Grid>
                
                <ListView x:Name="PlaylistView" Grid.Row="1" Background="Transparent" SelectionChanged="PlaylistView_SelectionChanged" IsItemClickEnabled="False" CanReorderItems="True" AllowDrop="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="28" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" Padding="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding Converter={StaticResource ItemIndexConverter}}" Foreground="{Binding IsPlaying, Converter={StaticResource ActiveItemBrushConverter}}" Style="{StaticResource NevCaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" Width="20"/>
                                
                                <FontIcon Grid.Column="1" Glyph="&#xE116;" FontSize="12" Foreground="{Binding IsPlaying, Converter={StaticResource ActiveItemBrushConverter}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                
                                <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{Binding IsPlaying, Converter={StaticResource ActiveItemBrushConverter}}" Style="{StaticResource NevBodyTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                
                                <TextBlock Grid.Column="3" Text="{Binding FormattedDuration}" Foreground="{Binding IsPlaying, Converter={StaticResource ActiveItemBrushConverter}}" Style="{StaticResource NevCaptionTextBlockStyle}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

    </Grid>
</Page>
