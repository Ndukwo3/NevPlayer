<Page
    x:Class="NevPlayer.App.Views.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NevPlayer.Core.Models"
    mc:Ignorable="d"
    Background="{StaticResource NevBackgroundBrush}">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" Spacing="24">
                <TextBlock Text="Music" Style="{StaticResource NevTitleTextBlockStyle}" FontSize="36" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6" Spacing="16">
                    <HyperlinkButton Content="Songs" Foreground="White" FontWeight="SemiBold" />
                    <HyperlinkButton Content="Albums" Foreground="#999999" />
                    <HyperlinkButton Content="Artists" Foreground="#999999" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Content="Add Music" Click="AddMusic_Click" Style="{StaticResource NevPrimaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
        </Grid>

        <!-- Media Grid -->
        <GridView x:Name="MediaGridView" Grid.Row="1" ItemsSource="{x:Bind MediaItems, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="MediaGridView_ItemClick" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                    <StackPanel Width="200" Margin="12">
                        <!-- Album Art -->
                        <Grid>
                            <Border Width="200" Height="200" CornerRadius="8" Background="#1E1E1E">
                                <Image Source="{Binding AlbumArtPath}" Stretch="UniformToFill" />
                            </Border>
                            <Button Content="&#xE107;" 
                                    FontFamily="Segoe Fluent Icons" 
                                    Background="#80000000" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top" 
                                    Margin="8" 
                                    Click="RemoveMusic_Click" 
                                    Tag="{x:Bind FilePath}" 
                                    CornerRadius="16" Width="32" Height="32" Padding="0"/>
                        </Grid>
                        
                        <!-- Metadata -->
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold" Margin="0,12,0,4" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Artist}" Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#999999" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind FormattedDuration}" Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#666666" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" CornerRadius="12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="64" Height="64" Foreground="{StaticResource NevAccentBrush}" />
                <TextBlock Text="Scanning media library..." Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
