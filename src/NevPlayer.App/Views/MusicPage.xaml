<Page
    x:Class="NevPlayer.App.Views.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NevPlayer.Core.Models"
    mc:Ignorable="d"
    Background="{StaticResource NevBackgroundBrush}">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" Spacing="24">
                <TextBlock Text="Music" Style="{StaticResource NevTitleTextBlockStyle}" FontSize="36" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6" Spacing="16">
                    <HyperlinkButton x:Name="SongsTab" Content="Songs" Foreground="White" FontWeight="SemiBold" Click="Tab_Click" Tag="Songs" />
                    <HyperlinkButton x:Name="PlaylistsTab" Content="Playlists" Foreground="#999999" Click="Tab_Click" Tag="Playlists" />
                    <HyperlinkButton x:Name="AlbumsTab" Content="Albums" Foreground="#999999" Click="Tab_Click" Tag="Albums" />
                    <HyperlinkButton x:Name="ArtistsTab" Content="Artists" Foreground="#999999" Click="Tab_Click" Tag="Artists" />
                </StackPanel>
            </StackPanel>

            <DropDownButton x:Name="AddMusicButton" Grid.Column="1" Content="Add Music" Style="{StaticResource NevPrimaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Add Folder" Icon="Folder" Click="AddFolder_Click"/>
                        <MenuFlyoutItem Text="Add Files" Icon="Document" Click="AddMusic_Click"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- Songs Grid -->
        <GridView x:Name="MediaGridView" Grid.Row="1" ItemsSource="{x:Bind MediaItems, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="MediaGridView_ItemClick" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                    <StackPanel Width="200" Margin="12">
                        <!-- Album Art -->
                        <Grid>
                            <Border Width="200" Height="200" CornerRadius="8" Background="#1E1E1E">
                                <Image Source="{Binding AlbumArtPath}" Stretch="UniformToFill" />
                            </Border>
                            <Button Content="&#xE107;" 
                                    FontFamily="Segoe Fluent Icons" 
                                    Background="#80000000" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top" 
                                    Margin="8" 
                                    Click="RemoveMusic_Click" 
                                    Tag="{x:Bind FilePath}" 
                                    CornerRadius="16" Width="32" Height="32" Padding="0"/>
                        </Grid>
                        
                        <!-- Metadata -->
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold" Margin="0,12,0,4" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Artist}" Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#999999" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind FormattedDuration}" Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#666666" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Playlists Grid -->
        <GridView x:Name="PlaylistsGridView" Grid.Row="1" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="PlaylistsGridView_ItemClick" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistModel">
                    <StackPanel Width="200" Margin="12">
                        <!-- Playlist Card -->
                        <Grid>
                            <Border Width="200" Height="200" CornerRadius="8" Background="#1A1A1A">
                                <Grid>
                                    <Image Source="{Binding ArtworkPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                    <!-- Equalizer Icon as overlay if no art -->
                                    <FontIcon Glyph="&#xE15C;" FontFamily="Segoe MDL2 Assets" FontSize="64" Foreground="{StaticResource NevAccentBrush}" 
                                              Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                                </Grid>
                            </Border>
                            <!-- Delete Button -->
                            <Button Content="&#xE107;" 
                                    FontFamily="Segoe Fluent Icons" 
                                    Background="#80000000" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top" 
                                    Margin="8" 
                                    Click="RemovePlaylist_Click" 
                                    Tag="{x:Bind Name}" 
                                    CornerRadius="16" Width="32" Height="32" Padding="0"/>
                        </Grid>
                        <!-- Playlist Title -->
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold" Margin="0,12,0,4" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Playlist" Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#999999" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Grouped Grid (used dynamically for Albums / Artists view) -->
        <GridView x:Name="GroupedGridView" Grid.Row="1" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="GroupedGridView_ItemClick" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <StackPanel Width="200" Margin="12">
                        <Grid>
                            <Border Width="200" Height="200" CornerRadius="8" Background="#252525">
                                <FontIcon Glyph="&#xE198;" FontFamily="Segoe MDL2 Assets" FontSize="64" Foreground="#999999" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind}" Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold" Margin="0,12,0,4" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Collection" Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#999999" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" CornerRadius="12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="64" Height="64" Foreground="{StaticResource NevAccentBrush}" />
                <TextBlock Text="Scanning media library..." Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
