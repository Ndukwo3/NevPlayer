<Page
    x:Class="NevPlayer.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NevPlayer.Core.Models"
    mc:Ignorable="d"
    Background="{StaticResource NevBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Padding="40" Spacing="40">
            <!-- Header -->
            <TextBlock Text="Welcome Back" Style="{StaticResource NevTitleTextBlockStyle}" FontSize="42" FontWeight="Bold" />

            <!-- Continue Watching Section -->
            <StackPanel Spacing="16">
                <TextBlock Text="Continue Watching" Style="{StaticResource NevHeaderTextBlockStyle}" FontWeight="SemiBold" Foreground="#CCCCCC" />
                
                <GridView x:Name="RecentGridView" ItemsSource="{x:Bind RecentItems, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="RecentGridView_ItemClick" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:HistoryItem">
                            <StackPanel Width="280" Margin="0,0,24,24">
                                <!-- Thumbnail placeholder -->
                                <Border Width="280" Height="158" CornerRadius="8" Background="#1E1E1E" Margin="0,0,0,12">
                                    <Grid>
                                        <Image Source="{Binding ArtworkPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                        
                                        <!-- Play button overlay -->
                                        <Border Background="#80000000" CornerRadius="8">
                                            <FontIcon Glyph="&#xE102;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="32" />
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <!-- Progress Bar -->
                                <ProgressBar Value="{x:Bind LastPosition.TotalSeconds}" Maximum="{x:Bind Duration.TotalSeconds}" Foreground="{StaticResource NevAccentBrush}" Background="#333333" Margin="0,0,0,8" Height="4" CornerRadius="2" />
                                
                                <!-- Title -->
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind LastPlayed}" Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#999999" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
