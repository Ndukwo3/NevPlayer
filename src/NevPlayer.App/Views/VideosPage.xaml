<Page
    x:Class="NevPlayer.App.Views.VideosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NevPlayer.Core.Models"
    mc:Ignorable="d"
    Background="{StaticResource NevBackgroundBrush}"
    Loaded="VideosPage_Loaded">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" 
                        Background="Transparent" BorderThickness="0" FontSize="20" 
                        Visibility="Collapsed" Click="BackButton_Click" 
                        VerticalAlignment="Top" Margin="0,8,0,0"/>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Videos" Style="{StaticResource NevTitleTextBlockStyle}" FontSize="42" FontWeight="Bold" />
                    <TextBlock x:Name="PageSubtitle" Text="Your local video collection" Style="{StaticResource NevHeaderTextBlockStyle}" Foreground="#999999" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <Button Content="Clear Videos" Style="{StaticResource NevSecondaryButtonStyle}" Click="ClearVideos_Click" />
                <DropDownButton Content="Add Videos" Style="{StaticResource NevPrimaryButtonStyle}">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Add Folder" Icon="Folder" Click="AddFolder_Click"/>
                            <MenuFlyoutItem Text="Add Files" Icon="Document" Click="AddVideos_Click"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- Folder Grid (Default) -->
        <GridView x:Name="FolderGridView" Grid.Row="1" ItemsSource="{x:Bind GroupedItems, Mode=OneWay}" 
                  IsItemClickEnabled="True" ItemClick="FolderGridView_ItemClick" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="280" Margin="12">
                        <!-- Folder Card with Cover Image -->
                        <Grid>
                            <Border Width="280" Height="158" CornerRadius="8" Background="#1E1E1E">
                                <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill" />
                            </Border>
                            <Border Background="#99000000" CornerRadius="8" />
                            <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Folder Name -->
                        <TextBlock Text="{Binding Key}" Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold" Margin="0,12,0,4" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Folder" Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#999999" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Video Grid (Inside Folder) -->
        <GridView x:Name="VideoGridView" Grid.Row="1" 
                  IsItemClickEnabled="True" ItemClick="MediaGridView_ItemClick" SelectionMode="None" Visibility="Collapsed">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                    <StackPanel Width="280" Margin="12">
                        <!-- Thumbnail -->
                        <Grid>
                            <Border Width="280" Height="158" CornerRadius="8" Background="#1E1E1E">
                                <Image Source="{Binding AlbumArtPath, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                            </Border>
                            <Button Content="&#xE107;" 
                                    FontFamily="Segoe Fluent Icons" 
                                    Background="#80000000" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top" 
                                    Margin="8" 
                                    Click="RemoveVideo_Click" 
                                    Tag="{x:Bind FilePath}" 
                                    CornerRadius="16" Width="32" Height="32" Padding="0"/>
                        </Grid>
                        
                        <!-- Metadata -->
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource NevBodyTextBlockStyle}" FontWeight="Bold" Margin="0,12,0,4" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind DisplayMetadata}" Style="{StaticResource NevCaptionTextBlockStyle}" Foreground="#999999" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48" Foreground="{StaticResource NevAccentBrush}" />
                <TextBlock Text="Importing videos..." Style="{StaticResource NevHeaderTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
